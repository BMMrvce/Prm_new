# ── Supabase (see supabase/README.md) ─────────────────────────────────────────────
# Browser-safe project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App secrets (server only) ─────────────────────────────────────────────────────
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=
# Mixed into every vault PIN hash; 32+ random characters (same command as above).
VAULT_PEPPER=
# Shared secret for the reminder job (supabase/cron.sql): any long random string.
CRON_SECRET=
# Public URL once deployed; OAuth redirect URIs and email links are built from it.
SITE_URL=

# ── Optional: Google sign-in for Gmail and YouTube ────────────────────────────────
# Enable the Gmail API and YouTube Data API v3 and add <site>/api/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: push reminders ──────────────────────────────────────────────────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your site URL or a mailto: address.
VAPID_SUBJECT=

# ── Optional: rotating OAUTH_TOKEN_ENCRYPTION_KEY ─────────────────────────────────
# Id stamped on newly sealed secrets (default v1) and older keys still accepted for
# reading; old secrets are re-sealed with the current key on first use.
OAUTH_TOKEN_KEY_ID=
# e.g. v0:<base64 32-byte key>,v-1:<base64 key>
OAUTH_TOKEN_PREVIOUS_KEYS=

# Development only: extra hostnames allowed to open `pnpm dev`, comma-separated
# (Cloudflare quick tunnels, *.trycloudflare.com, are already allowed).
# ALLOWED_DEV_ORIGINS=*.ngrok-free.app
      